{
  "name": "barberia",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20 <25",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint \"src/**/*.{js,jsx}\" \"scripts/**/*.mjs\" \"e2e/**/*.mjs\" vite.config.js eslint.config.js playwright.config.mjs",
    "test": "node scripts/verify-agenda.mjs && node scripts/verify-saas-foundation.mjs && node scripts/verify-onboarding.mjs && node scripts/verify-billing.mjs && node scripts/verify-billing-serverless.mjs && node scripts/verify-commercial-prep.mjs && node scripts/verify-crm-commercial.mjs && node scripts/verify-commercial-pilot.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "e2e:cleanup": "node scripts/e2e-cleanup.mjs",
    "e2e:preflight": "node scripts/e2e-sandbox-preflight.mjs",
    "e2e:qa:migration-plan": "node scripts/e2e-qa-migration-plan.mjs",
    "e2e:qa:fixtures": "node scripts/e2e-qa-fixtures.mjs",
    "e2e:qa:auth-smoke": "node scripts/.qa-auth-smoke.mjs",
    "check": "npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.23.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "vite": "^8.2.0"
  }
}
