# Configurar como variables privadas del servidor n8n. No usar en VITE_* ni subir valores reales.
SUPABASE_URL=https://tu-proyecto.supabase.co
# Production workflow only; keep the shared QA URL above unchanged.
SUPABASE_PRODUCTION_URL=https://tu-production-project.supabase.co
# "Austral Panel Send - Instance Routed": proyecto Supabase del mismo entorno
# que la Edge Function whatsapp-panel-send (QA o producción, nunca mezclados).
PANEL_SEND_SUPABASE_URL=https://tu-proyecto-del-entorno.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me-in-n8n
EVOLUTION_BASE_URL=https://tu-evolution.example.com
EVOLUTION_API_KEY=replace-me-in-n8n
EVOLUTION_WEBHOOK_SECRET=replace-me-in-n8n
DEEPSEEK_API_KEY=replace-me-in-n8n
# shadow no envía mensajes ni crea turnos; cambiar a live sólo después de la aprobación formal.
WHATSAPP_MODE=shadow
PILOT_MODE=shadow
