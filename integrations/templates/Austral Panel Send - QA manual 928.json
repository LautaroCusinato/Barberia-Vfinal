{
  "name": "Austral QA 928 - envío manual del panel",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "austral-qa-panel-send-928",
        "authentication": "headerAuth",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "panel-send-webhook",
      "webhookId": "8b9a9961-3a88-491c-9d1f-155fe50e0f0f",
      "name": "Recibir envío del panel",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        200
      ],
      "notes": "Bind a Header Auth credential named X-Austral-Panel-Secret with the same secret as WHATSAPP_PANEL_SEND_SECRET in the Edge Function. Responds only from the Respond to Webhook nodes, after Evolution answers.",
      "credentials": {
        "httpHeaderAuth": {
          "id": "australQa928PanelHeader",
          "name": "Austral QA 928 Panel Header"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Valida el pedido de whatsapp-panel-send. Ningún dato del body es\n// autoridad: la instancia se vuelve a verificar contra Supabase.\nconst body = $input.first()?.json?.body ?? {};\nconst telefono = typeof body.telefono === 'string' ? body.telefono : '';\nconst texto = typeof body.texto === 'string' ? body.texto.trim() : '';\nconst tenantId = Number(body.barberia_id);\nconst instance = typeof body.instance === 'string' ? body.instance.trim().toLowerCase() : '';\nconst clientMessageId = typeof body.client_message_id === 'string' ? body.client_message_id : null;\nconst valid = tenantId === 928 && instance === 'austral-qa-tenant-928' && /^549[1-9][0-9]{9}$/.test(telefono)\n  && texto.length > 0 && texto.length <= 4096\n  && Number.isSafeInteger(tenantId) && tenantId > 0\n  && /^[a-z0-9._-]{1,200}$/.test(instance)\n  && (clientMessageId === null || /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(clientMessageId));\nreturn [{ json: { valid, telefono, texto, tenantId, instance, clientMessageId, reason: valid ? null : 'invalid_request' } }];"
      },
      "id": "panel-send-validate",
      "name": "Validar solicitud",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        200
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 1
          },
          "conditions": [
            {
              "id": "valid",
              "leftValue": "={{ $json.valid === true }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "panel-send-valid",
      "name": "Solicitud válida",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        480,
        200
      ]
    },
    {
      "parameters": {
        "url": "https://cmsymmszlzikqpvfqjre.supabase.co/rest/v1/saas_integraciones",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "barberia_id",
              "value": "={{ 'eq.' + $('Validar solicitud').first().json.tenantId }}"
            },
            {
              "name": "proveedor",
              "value": "eq.evolution"
            },
            {
              "name": "integration_type",
              "value": "eq.whatsapp"
            },
            {
              "name": "select",
              "value": "external_instance_id,estado"
            },
            {
              "name": "order",
              "value": "created_at.desc"
            },
            {
              "name": "limit",
              "value": "1"
            }
          ]
        },
        "sendHeaders": false,
        "options": {
          "timeout": 10000
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpCustomAuth"
      },
      "id": "panel-send-lookup",
      "name": "Leer integración del negocio",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        120
      ],
      "alwaysOutputData": true,
      "retryOnFail": false,
      "onError": "continueErrorOutput",
      "notes": "Bind the environment Supabase service-role credential (apikey + Authorization headers). The tenant comes from the validated request; the instance is read here and compared, never trusted from the body.",
      "credentials": {
        "httpCustomAuth": {
          "id": "australQa36FnSecret",
          "name": "Austral QA 36 Funciones"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// La instancia sólo se usa si es la registrada y conectada de ESE negocio.\nconst req = $('Validar solicitud').first().json;\nconst rows = $input.all().map((item) => item.json).filter((row) => row && typeof row === 'object' && Object.keys(row).length > 0);\nconst row = rows.length === 1 ? rows[0] : null;\nconst registered = typeof row?.external_instance_id === 'string' ? row.external_instance_id.trim().toLowerCase() : '';\nconst authorized = Boolean(row) && row.estado === 'conectado' && registered !== '' && registered === req.instance;\nreturn [{ json: { authorized, instance: authorized ? registered : null, reason: authorized ? null : 'instance_not_authorized' } }];"
      },
      "id": "panel-send-authorize",
      "name": "Autorizar instancia",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        120
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 1
          },
          "conditions": [
            {
              "id": "authorized",
              "leftValue": "={{ $json.authorized === true }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "panel-send-authorized",
      "name": "Instancia autorizada",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1200,
        120
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.EVOLUTION_BASE_URL + '/message/sendText/' + encodeURIComponent($('Autorizar instancia').first().json.instance) }}",
        "sendHeaders": false,
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ number: $('Validar solicitud').first().json.telefono, text: $('Validar solicitud').first().json.texto }) }}",
        "options": {
          "timeout": 15000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "id": "panel-send-evolution",
      "name": "Enviar por Evolution",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1440,
        40
      ],
      "retryOnFail": false,
      "onError": "continueErrorOutput",
      "notes": "Bind the environment Evolution API credential. No automatic retry: a timeout may have sent the message, so it is reported as uncertain.",
      "credentials": {
        "httpHeaderAuth": {
          "id": "australQa928Evolution",
          "name": "Austral QA 928 Evolution"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Evolution respondió (neverError): 2xx con key.id = aceptado; 4xx (salvo\n// 408) = rechazado; el resto, o un 2xx sin id, no prueba nada = incierto.\n// Ninguna respuesta de Evolution prueba la ENTREGA al teléfono.\nconst res = $input.first()?.json ?? {};\nconst status = Number(res.statusCode);\nconst body = res.body && typeof res.body === 'object' ? res.body : {};\nconst id = typeof body?.key?.id === 'string' && body.key.id.trim() ? body.key.id.trim().slice(0, 200) : null;\nlet result = 'uncertain';\nif (status >= 200 && status < 300 && id) result = 'accepted';\nelse if (status >= 400 && status < 500 && status !== 408) result = 'rejected';\nconst httpStatus = result === 'accepted' ? 200 : result === 'rejected' ? 422 : 502;\nreturn [{ json: { result, message_id: result === 'accepted' ? id : null, httpStatus, provider_status: Number.isFinite(status) ? status : null } }];"
      },
      "id": "panel-send-classify",
      "name": "Clasificar respuesta de Evolution",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1680,
        0
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ result: $json.result, message_id: $json.message_id, provider_status: $json.provider_status }) }}",
        "options": {
          "responseCode": "={{ $json.httpStatus }}"
        }
      },
      "id": "panel-send-respond-result",
      "name": "Responder resultado",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1920,
        0
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ result: 'uncertain', reason: 'evolution_no_response' }) }}",
        "options": {
          "responseCode": 502
        }
      },
      "id": "panel-send-respond-uncertain",
      "name": "Responder incierto",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1680,
        160
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ result: 'rejected', reason: $json.reason || 'instance_lookup_failed' }) }}",
        "options": {
          "responseCode": 422
        }
      },
      "id": "panel-send-respond-rejected",
      "name": "Responder rechazo",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1200,
        360
      ]
    }
  ],
