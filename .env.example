# Supabase (opcional). Sin estas credenciales el panel funciona
# con datos de ejemplo (mockData.js).
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-publica

# ID de la barbería en Supabase (por defecto: 1)
VITE_BARBERIA_ID=1

# Identidad del negocio para el panel antes de iniciar sesión.
# En una instalación SaaS cada tenant puede definir estos valores.
VITE_BUSINESS_NAME=Barbería Central
VITE_BUSINESS_VERTICAL=barberia
VITE_PRODUCT_NAME=Agenda
VITE_APP_VERSION=dev
# Opcional: fijar el origen público de Auth en un despliegue conocido.
# VITE_APP_BASE_URL=https://barberia.cuchitron.lat
# VITE_SALES_WHATSAPP_NUMBER=
# Commercial launch mode: manual keeps checkout/card actions out of the
# customer experience while the automatic billing backend remains available
# for a separately approved phase.
VITE_COMMERCIAL_BILLING_MODE=manual

# Webhook público de n8n utilizado por las respuestas manuales del panel.
VITE_N8N_SEND_WEBHOOK_URL=https://tu-n8n.example.com/webhook/panel-enviar-wsp

# Billing sandbox (sólo backend/Cloudflare Worker/Supabase Edge Function;
# nunca anteponer VITE_ ni copiar estos valores al navegador).
# MERCADOPAGO_ACCESS_TOKEN=
# MERCADOPAGO_WEBHOOK_SECRET=
# MERCADOPAGO_API_BASE_URL=https://api.mercadopago.com
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_WEBHOOK_ID=
# PAYPAL_API_BASE_URL=https://api-m.sandbox.paypal.com
# SUPABASE_URL=https://tu-proyecto.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# APP_BASE_URL=https://tu-dominio.example
# BILLING_CRON_SECRET=
# BILLING_OUTBOX_SINK_URL=
# BILLING_OUTBOX_SINK_SECRET=

# Mercado Pago production readiness (offline only; do not enable during RC).
# Access token/webhook secret remain server-side; the Public Key is the only
# Mercado Pago value allowed in the browser when the feature is enabled.
# VITE_MERCADOPAGO_PUBLIC_KEY=
# Sandbox TEST seller public key. Keep this separate from the production key;
# it is only used by the tenant-6 sandbox Card Payment Brick.
# VITE_MERCADOPAGO_SANDBOX_PUBLIC_KEY=
# TEST buyer identity used server-side by the isolated tenant-6 E2E flow.
# Never send this from the browser or reuse the seller/tenant billing email.
# MERCADOPAGO_SANDBOX_PAYER_EMAIL=
# MERCADOPAGO_PRODUCTION_SELLER_ID=
# MERCADOPAGO_PRODUCTION_APPLICATION_ID=
# MERCADOPAGO_PRODUCTION_PLAN_ID=
# MERCADOPAGO_PUBLIC_KEY_CONFIGURED=0
# BILLING_PRODUCTION_CHECKOUT_MODE=card_token_id
# BILLING_PRODUCTION_READINESS=blocked
# BILLING_PRODUCTION_ENABLED=0
# BILLING_PRODUCTION_PILOT_TENANT_ID=
# BILLING_PRODUCTION_ALLOWED_TENANT_IDS=
# BILLING_PRODUCTION_CHECKOUT_CONFIRMATION=
# BILLING_PRODUCTION_BACKUP_VERIFIED=0
# BILLING_PRODUCTION_ALERTING_VERIFIED=0

# QA/E2E aislado (nunca usar el project ref productivo ni copiar secretos de producción).
# Estos valores se cargan sólo en el entorno de test/CI, nunca en VITE_*.
# E2E_ENVIRONMENT=qa
# E2E_REAL_SUPABASE=1
# E2E_SUPABASE_PROJECT_REF=cmsymmszlzikqpvfqjre
# E2E_ALLOWED_PROJECT_REF=cmsymmszlzikqpvfqjre
# E2E_SUPABASE_URL=https://cmsymmszlzikqpvfqjre.supabase.co
# E2E_SUPABASE_ANON_KEY=
# E2E_SUPABASE_SERVICE_ROLE_KEY=
# E2E_TEST_PREFIX=E2E_QA_
# E2E_ALLOW_CLEANUP=1
# E2E_ALLOW_FIXTURE_SEED=1
# E2E_QA_PASSWORD=
