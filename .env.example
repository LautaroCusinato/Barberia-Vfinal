# Supabase (opcional). Sin estas credenciales el panel funciona
# con datos de ejemplo (mockData.js).
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-publica

# ID de la barbería en Supabase (por defecto: 1)
VITE_BARBERIA_ID=1

# Identidad del negocio para el panel antes de iniciar sesión.
# En una instalación SaaS cada tenant puede definir estos valores.
VITE_BUSINESS_NAME=Barbería Central
VITE_BUSINESS_VERTICAL=barberia
VITE_PRODUCT_NAME=Agenda
VITE_APP_VERSION=dev
# Opcional: fijar el origen público de Auth en un despliegue conocido.
# VITE_APP_BASE_URL=https://barberia.cuchitron.lat

# Webhook público de n8n utilizado por las respuestas manuales del panel.
VITE_N8N_SEND_WEBHOOK_URL=https://tu-n8n.example.com/webhook/panel-enviar-wsp

# Billing sandbox (sólo backend/Cloudflare Worker/Supabase Edge Function;
# nunca anteponer VITE_ ni copiar estos valores al navegador).
# MERCADOPAGO_ACCESS_TOKEN=
# MERCADOPAGO_WEBHOOK_SECRET=
# MERCADOPAGO_API_BASE_URL=https://api.mercadopago.com
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_WEBHOOK_ID=
# PAYPAL_API_BASE_URL=https://api-m.sandbox.paypal.com
# SUPABASE_URL=https://tu-proyecto.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# APP_BASE_URL=https://tu-dominio.example
# BILLING_CRON_SECRET=
# BILLING_OUTBOX_SINK_URL=
# BILLING_OUTBOX_SINK_SECRET=

# QA/E2E aislado (nunca usar el project ref productivo ni copiar secretos de producción).
# Estos valores se cargan sólo en el entorno de test/CI, nunca en VITE_*.
# E2E_ENVIRONMENT=qa
# E2E_REAL_SUPABASE=1
# E2E_SUPABASE_PROJECT_REF=cmsymmszlzikqpvfqjre
# E2E_ALLOWED_PROJECT_REF=cmsymmszlzikqpvfqjre
# E2E_SUPABASE_URL=https://cmsymmszlzikqpvfqjre.supabase.co
# E2E_SUPABASE_ANON_KEY=
# E2E_SUPABASE_SERVICE_ROLE_KEY=
# E2E_TEST_PREFIX=E2E_QA_
# E2E_ALLOW_CLEANUP=1
# E2E_ALLOW_FIXTURE_SEED=1
# E2E_QA_PASSWORD=
